@baseUrl = http://localhost:8080
@token = REPLACE_WITH_NURSE_OR_DON_SESSION_TOKEN
@goalId = 1

### Create one intervention under a goal in a DRAFT version.
### Returns 201; requiresTaskGeneration defaults to true, sortOrder to 0.
POST {{baseUrl}}/api/v2/care-goals/{{goalId}}/interventions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Hỗ trợ di chuyển theo kế hoạch",
