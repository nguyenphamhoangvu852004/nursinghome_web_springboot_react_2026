  "responsibleDiscipline": "NURSING",
  "assignedRole": "CNA",
  "frequencyCode": "DAILY",
  "scheduleDefinition": "{\"times\":[\"08:00\"]}",
  "startDate": "2026-10-23",
  "endDate": "2026-11-15",
  "prnCriteria": null,
  "evidenceOrRationale": "Theo nhu cầu được ghi nhận trong mục tiêu chăm sóc",
  "requiresTaskGeneration": true,
  "sortOrder": 10
}
